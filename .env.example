# Copia este archivo como .env y completa los valores antes de
# `docker compose up -d --build`. Nunca subas .env al repositorio.

# Dominio público. Con un dominio real, Caddy obtiene el certificado HTTPS
# solo (los puertos 80 y 443 deben llegar a este servidor). Para probar en tu
# equipo usa "localhost" y acepta el aviso del navegador.
SITE_ADDRESS=localhost
DJANGO_ALLOWED_HOSTS=localhost
PUBLIC_APP_URL=https://localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost

# Secretos: genera valores largos y aleatorios, por ejemplo con
#   python -c "import secrets; print(secrets.token_hex(32))"
# POSTGRES_PASSWORD va dentro de una URL: usa solo letras y números.
DJANGO_SECRET_KEY=cambia-esto-por-un-secreto-largo-y-aleatorio
POSTGRES_PASSWORD=cambiaestacontrasena

# Correo para verificación de cuentas y recuperación de contraseña.
DEFAULT_FROM_EMAIL=Vértice <no-reply@tu-dominio.com>
EMAIL_HOST=smtp.tu-proveedor.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true

# HSTS obliga al navegador a usar HTTPS en el dominio durante este tiempo.
# En producción deja un año (31536000); para probar con localhost usa 60.
DJANGO_SECURE_HSTS_SECONDS=31536000

# Opcional: asistente de modelos con Azure OpenAI (ver README).
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=
